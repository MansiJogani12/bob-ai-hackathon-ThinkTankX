# YieldSentinel AI optional environment variables
# Copy the relevant values into src/backend/.env or src/frontend/.env.local.
# Never commit real credentials.

# Backend model configuration
MODEL_PATH=yieldsentinel_best_model.pkl

# Frontend-to-backend URL
NEXT_PUBLIC_YIELDSENTINEL_BACKEND_URL=http://127.0.0.1:8000

# Supabase authentication and saved analyses (optional)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase backend persistence (optional; keep the service key server-side)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenRouter chat and corrective-action assistant (optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
